{
  "name": "andersogkristine-no",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run src/scripts/prebuild.ts && bun run db:migrate:local && astro dev",
    "db:migrate:local": "bunx wrangler d1 migrations apply andersogkristine-gallery --local",
    "db:migrate:remote": "bunx wrangler d1 migrations apply andersogkristine-gallery --remote",
    "build": "bun run src/scripts/prebuild.ts && astro build",
    "deploy": "bun run build && bunx wrangler deploy",
    "preview": "astro preview",
    "test": "bun test",
    "lint": "biome lint .",
    "check": "tsc --noEmit",
    "ci": "bun run src/scripts/prebuild.ts && biome ci . && bun run check && bun test && bun run build",
    "format": "biome format .",
    "astro": "astro",
    "dev:clean": "rm -rf .wrangler/state/v3 .astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@astrojs/react": "7.1.4",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@notionhq/client": "5.31.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.7",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-types": "1.4.4",
    "typescript": "7.0.2"
  }
}
