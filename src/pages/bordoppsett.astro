---
import { env } from 'cloudflare:workers';
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SeatingChart from '../components/SeatingChart';
import { fetchAllSeatingData, type TableWithGuests } from '../services/notion';

let tables: TableWithGuests[] = [];
let errorMsg: string | null = null;

try {
  tables = await fetchAllSeatingData(env as Env, Astro.locals?.cfContext);
} catch (err) {
  console.error("Error loading seating in page:", err);
  errorMsg = "Det oppstod en feil ved lasting av bordoppsettet. Vennligst prøv igjen senere.";
}
---

<SubpageLayout
  title="Bordoppsett & Bordplassering - Kristine og Anders"
  heading="Bordplassering"
  subtitle="Finn din plass for kvelden. Skriv inn navnet ditt i søkefeltet under for å finne ditt bord og sete."
  subtitleClass="max-w-xl mx-auto"
  width="max-w-7xl"
  center={false}
  card={false}
>
  {errorMsg ? (
    <div class="bg-red-50 border border-red-200 text-red-700 px-6 py-4 rounded-xl text-center max-w-lg mx-auto font-sans shadow-md">
      {errorMsg}
    </div>
  ) : (
    /* React island: search bar + interactive table grid */
    <SeatingChart tables={tables} client:load />
  )}
</SubpageLayout>
