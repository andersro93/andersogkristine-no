---
import { env } from '../runtime';
import SubpageLayout from '../layouts/SubpageLayout.astro';
import { fetchToastmasters } from '../services/notion';

let toastmasters: { name: string; email: string; photo: string }[] = [];
const context = Astro.locals?.cfContext;
try {
  toastmasters = await fetchToastmasters(env, context);
} catch (err) {
  console.error("Failed to load toastmasters from Notion:", err);
}

const toastmasterNames = toastmasters.map(t => t.name);
const namesText = toastmasterNames.length === 2
  ? `${toastmasterNames[0]} eller ${toastmasterNames[1]}`
  : toastmasterNames.join(', ');
---

<SubpageLayout
  title="Toastmaster - Kristine og Anders"
  description="Informasjon om toastmaster for bryllupet til Kristine og Anders. Kontakt toastmaster om du ønsker å holde tale."
  heading="Toastmaster"
  subtitle="Taler og underholdning"
  width="max-w-5xl"
>
  {toastmasters.length > 0 ? (
        <div class="flex flex-col items-center text-center space-y-8">

          {/* Toastmaster photos and names */}
          <div class={`grid gap-8 md:gap-12 ${toastmasters.length > 1 ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-1'} justify-items-center`}>
            {toastmasters.map((tm) => (
              <div class="flex flex-col items-center space-y-4">
                {/* Photo */}
                <div class="w-36 h-36 md:w-44 md:h-44 rounded-full overflow-hidden border-4 border-brand-title/10 shadow-lg">
                  <img
                    src={tm.photo}
                    alt={tm.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                </div>

                {/* Name & Role */}
                <div class="space-y-1">
                  <h2 class="text-3xl md:text-4xl">{tm.name}</h2>
                  <p class="text-lead">Toastmaster</p>
                </div>

                {/* Email */}
                {tm.email && (
                  <p class="text-body text-base">
                    <a
                      href={`mailto:${tm.email}`}
                      class="text-brand-title hover:underline font-medium transition-colors"
                    >
                      {tm.email}
                    </a>
                  </p>
                )}
              </div>
            ))}
          </div>

          {/* Divider */}
          <div class="w-16 h-px bg-brand-title/15"></div>

          {/* Contact info */}
          <div class="max-w-lg space-y-4">
            <p class="text-body text-base leading-relaxed">
              Ønsker du å holde tale eller lignende? Ta kontakt med {namesText}.
            </p>
          </div>

          {/* Divider */}
          <div class="w-16 h-px bg-brand-title/15"></div>

          {/* Guidelines */}
          <div class="max-w-lg space-y-4 text-left">
            <h3 class="text-center">Tips til taler</h3>
            <ul class="space-y-3 text-body text-base">
              <li class="flex items-start gap-3">
                <span class="text-brand-title text-sm mt-0.5 select-none">&#9670;</span>
                <span>Gi gjerne toastmaster beskjed i god tid om du ønsker å holde tale</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-title text-sm mt-0.5 select-none">&#9670;</span>
                <span>Hold talen kort og personlig &mdash; rundt 3-5 minutter er perfekt</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-title text-sm mt-0.5 select-none">&#9670;</span>
                <span>Sanger, dikt eller andre innslag er også velkomne!</span>
              </li>
            </ul>
          </div>

        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-body text-base">Informasjon om toastmaster kommer snart.</p>
        </div>
      )}
</SubpageLayout>
