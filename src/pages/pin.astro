---
import Icon from '../components/ui/Icon.astro';
import Spinner from '../components/ui/Spinner.astro';
import SubpageLayout from '../layouts/SubpageLayout.astro';
import { weddingConfig } from '../config';
import { LOCKOUT_MINUTES } from '../services/pin';

const errorParam = Astro.url.searchParams.get('error');
let initialError = '';
if (errorParam === 'invalid_invite') {
  initialError = 'Ugyldig invitasjonskode. Vennligst tast inn PIN-koden for å få tilgang.';
} else if (errorParam === 'verification_error') {
  initialError = 'Det oppstod en feil ved verifisering av invitasjonskoden. Vennligst prøv igjen med PIN-koden.';
} else if (errorParam === 'too_many_attempts') {
  initialError = `For mange forsøk med invitasjonskode. Vennligst prøv igjen om ${LOCKOUT_MINUTES} minutter, eller tast inn PIN-koden.`;
}
---

<SubpageLayout title="Adgangskontroll - Kristine & Anders" width="max-w-xl" backLink={false} mainClass="select-none" cardClass="motion-safe:animate-fade-in">
  <div slot="header" class="text-center mb-10 motion-safe:animate-fade-in">
    <h1 class="mb-2">
      {weddingConfig.names.bride} <span class="font-sans text-2xl font-light italic opacity-95">{weddingConfig.names.ampersand}</span> {weddingConfig.names.groom}
    </h1>
    <p class="text-body-serif">Velkommen til vårt bryllup</p>
    <div class="w-24 h-px bg-brand-title/20 mx-auto mt-6"></div>
  </div>

  <div class="text-center py-6">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-brand-title/5 text-brand-title mb-4">
          <Icon name="lock" class="w-6 h-6" />
        </div>

        <h3 class="mb-3">Tast inn adgangskode</h3>
        <p class="text-caption max-w-sm mx-auto mb-8">
          Nettstedet er passordbeskyttet. Vennligst oppgi PIN-koden du finner i invitasjonen for å se innholdet.
        </p>

        <!-- Error Container -->
        <div id="error-message" class:list={["alert-error mb-6 transition-all duration-300", !initialError && "hidden"]}>
          {initialError}
        </div>

        <!-- Form -->
        <form id="pin-form" class="space-y-4 max-w-sm mx-auto">
          <div class="relative">
            <input 
              type="password" 
              name="pin" 
              id="pin-input"
              required
              maxlength="32"
              placeholder="••••" 
              class="input-base w-full px-4 py-3 text-center tracking-widest text-xl font-semibold"
            />
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            class="btn-primary w-full px-8 py-3 duration-300 hover:shadow-lg flex items-center justify-center gap-2"
          >
            <span id="btn-text">Åpne bryllupsside</span>
            <Spinner class="hidden h-5 w-5 text-brand-bg" id="loading-spinner" />
          </button>
        </form>
      </div>
</SubpageLayout>

<script>
  const form = document.getElementById('pin-form') as HTMLFormElement;
  const input = document.getElementById('pin-input') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const spinner = document.getElementById('loading-spinner');
  const errorDiv = document.getElementById('error-message');

  if (form && input && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Clear previous error
      if (errorDiv) {
        errorDiv.classList.add('hidden');
        errorDiv.innerText = '';
      }

      // Start loading state
      input.disabled = true;
      submitBtn.disabled = true;
      if (btnText) btnText.innerText = 'Verifiserer...';
      if (spinner) spinner.classList.remove('hidden');

      try {
        const res = await fetch('/api/validate-pin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pin: input.value })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          // Success: redirect to target or homepage
          // Only allow same-origin relative paths as redirect target (no open redirect)
          const urlParams = new URLSearchParams(window.location.search);
          const rawNext = urlParams.get('next') || '/';
          const next = /^\/(?![/\\])/.test(rawNext) ? rawNext : '/';
          if (btnText) btnText.innerText = '✓';
          if (spinner) spinner.classList.add('hidden');
          setTimeout(() => {
            window.location.href = next;
          }, 400);
        } else {
          // Error response
          throw new Error(data.error || 'Ugyldig PIN-kode.');
        }
      } catch (err: any) {
        // Reset inputs and display error
        input.disabled = false;
        submitBtn.disabled = false;
        if (btnText) btnText.innerText = 'Åpne bryllupsside';
        if (spinner) spinner.classList.add('hidden');
        input.value = '';
        input.focus();

        if (errorDiv) {
          errorDiv.innerText = err.message;
          errorDiv.classList.remove('hidden', 'motion-safe:animate-shake');
          void errorDiv.offsetWidth;
          errorDiv.classList.add('motion-safe:animate-shake');
        }
      }
    });
  }
</script>
