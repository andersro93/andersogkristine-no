---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import Faq from "../components/Faq.astro";
import { DEFAULT_FLAGS } from '../services/notion';

// Feature flags are resolved once per request by the middleware
const flags = Astro.locals.flags ?? DEFAULT_FLAGS;
---

<SubpageLayout title="Praktisk Informasjon - Kristine og Anders" width="max-w-6xl" center={false} card={false}>
  <Faq flags={flags} />
</SubpageLayout>
