---
import { env } from '../runtime';
import SubpageLayout from '../layouts/SubpageLayout.astro';
import RSVPForm from '../components/RSVPForm';
import { DEFAULT_FLAGS, fetchAllergyOptions, fetchInviteByCode, type Invite } from '../services/notion';
import {
  LOCKOUT_MINUTES,
  SESSION_COOKIE_NAME,
  SESSION_COOKIE_OPTIONS,
  checkRateLimit,
  generateSessionCookie,
  recordFailedAttempt,
} from '../services/pin';

// Server-side invite lookup
const code = Astro.url.searchParams.get('code');
let invite: Invite | null = null;
let errorMsg: string | null = null;
let allergySuggestions: string[] = [];

if (code) {
  const ip = Astro.clientAddress || 'unknown-ip';
  const kv = env?.CACHE;
  try {
    const limit = await checkRateLimit(ip, kv, 'invite');
    if (!limit.allowed) {
      errorMsg = `For mange forsøk. Vennligst prøv igjen om ${LOCKOUT_MINUTES} minutter.`;
    } else {
      invite = await fetchInviteByCode(code, env);
      if (invite) {
        // Existing options are offered back as suggestions so guests reuse the
        // same spelling instead of creating a new option each time.
        allergySuggestions = await fetchAllergyOptionsenv;

        // Valid invite: grant a site-wide session so guests can browse other pages
        const cookieValue = generateSessionCookieenv;
        Astro.cookies.set(SESSION_COOKIE_NAME, cookieValue, SESSION_COOKIE_OPTIONS);
      } else {
        await recordFailedAttempt(ip, kv, 'invite');
        errorMsg = "Ugyldig invitasjonskode. Vennligst sjekk at koden stemmer.";
      }
    }
  } catch (err) {
    console.error("Error fetching invite in page:", err);
    errorMsg = "Det oppstod en feil ved henting av din invitasjon. Vennligst prøv igjen.";
  }
}

// Feature flags are resolved once per request by the middleware
const flags = Astro.locals.flags ?? DEFAULT_FLAGS;
---

<SubpageLayout title="Svar på invitasjon - Kristine og Anders" heading="Svar på invitasjon" subtitle="Svarfrist: 26. august 2026">
  {!invite ? (
        /* State A: Code entry form (no JS needed — plain HTML form GET) */
        <div class="text-center py-6">
          {errorMsg && (
            <div class="alert-error mb-6">
              {errorMsg}
            </div>
          )}
          
          <h3 class="mb-4">Vennligst oppgi din invitasjonskode</h3>
          <p class="text-caption max-w-md mx-auto mb-8">
            For å kunne svare elektronisk må du skrive inn den unike koden som står i invitasjonen du har mottatt.
          </p>

          <form method="GET" action="/rsvp" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
            <input 
              type="text" 
              name="code" 
              required
              placeholder="F.eks. LILO2026" 
              class="input-base flex-1 px-4 py-3 text-center uppercase tracking-widest text-lg font-medium"
              value={code || ""}
            />
            <button 
              type="submit" 
              class="btn-primary px-8 py-3 duration-300 hover:shadow-lg"
            >
              Finn invitasjon
            </button>
          </form>
        </div>
      ) : (
        /* State B: React island handles all the interactive form logic */
        <RSVPForm invite={invite} allergySuggestions={allergySuggestions} seatingEnabled={flags.seating} musicEnabled={flags.music} client:load />
      )}
</SubpageLayout>
