---
import { weddingConfig } from '../config';

interface Props {
  flags: Record<string, boolean>;
}

const { flags } = Astro.props;
---

<footer class="py-16 px-4 bg-brand-bg text-center space-y-4">
  <div class="w-8 h-[1px] bg-brand-title/20 mx-auto mb-6"></div>
  
  <p class="font-wedding text-4xl md:text-5xl text-brand-title select-none">
    {weddingConfig.names.bride.charAt(0)} & {weddingConfig.names.groom.charAt(0)}
  </p>

  <p class="text-lead text-brand-text/70">
    Vi gleder oss til å feire dagen med dere!
  </p>

  <div class="flex flex-wrap items-center justify-center gap-x-4 sm:gap-x-6 gap-y-1 text-xs uppercase tracking-wider text-brand-title font-medium pt-4 select-none">
    {
      [
        flags.rsvp && <a href="/rsvp" class="hover:underline inline-block py-2">Svar på invitasjon</a>,
        <a href="/faq" class="hover:underline inline-block py-2">Praktisk info</a>,
        flags.seating && <a href="/bordoppsett" class="hover:underline inline-block py-2">Bordplassering</a>,
        <a href="/toastmaster" class="hover:underline inline-block py-2">Toastmaster</a>,
        <a href="/forlovere" class="hover:underline inline-block py-2">Forlovere</a>,
        flags.map && <a href="/kart" class="hover:underline inline-block py-2">Kart</a>,
        flags.music && <a href="/musikk" class="hover:underline inline-block py-2">Musikkønsker</a>,
        flags.gallery && <a href="/galleri" class="hover:underline inline-block py-2">Galleri</a>
      ]
        .filter(Boolean)
        .map((link, idx, arr) => (
          <>
            {link}
            {idx < arr.length - 1 && <span class="text-brand-title/20">|</span>}
          </>
        ))
    }
  </div>


  <p class="text-caption text-xs text-brand-text/50 pt-8">
    &copy; {new Date().getFullYear()} &mdash; Laget med kjærlighet
  </p>
</footer>
