---
import { env } from '../runtime';
import Icon from './ui/Icon.astro';
import { fetchFaqFromNotion } from '../services/notion';

interface Props {
  flags: Record<string, boolean>;
}

const { flags } = Astro.props;
// Falls back to the prebuild snapshot inside the fetcher if Notion is unreachable
const faqs = await fetchFaqFromNotion(env, Astro.locals?.cfContext);
---

<section id="practical" class="py-20 px-4 md:px-8 bg-brand-bg max-w-6xl mx-auto border-b border-brand-title/5">
  
  <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
    <h1>Spørsmål og svar</h1>
    <div class="w-12 h-px bg-brand-title/30 mx-auto"></div>
    <p class="text-lead">Alt du trenger å vite om bryllupsdagen</p>
  </div>

  <div class="divide-y divide-brand-title/15">
    {faqs.map((faq) => (
      <details class="group py-5 first:pt-0 last:pb-0 cursor-pointer">
        <summary class="flex justify-between items-center font-serif text-lg md:text-xl text-brand-title font-semibold list-none select-none outline-hidden">
          <span>{faq.question}</span>
          <span class="text-brand-title/60 group-open:rotate-180 group-hover:text-brand-title transition-transform duration-300">
            <Icon name="chevronDown" class="w-5 h-5" />
          </span>
        </summary>
        <div class="mt-4 text-body max-w-2xl group-open:motion-safe:animate-fade-in" set:html={faq.answer}>
        </div>
      </details>
    ))}
  </div>
</section>
