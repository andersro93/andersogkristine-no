---
/**
 * Site-wide sticky navigation, in two variants:
 *  - overlay (home): fixed on top of the fullscreen hero, white text, turns
 *    into the frosted bar once the page scrolls past the first 40px.
 *  - solid (subpages): sticky, always frosted.
 *
 * Desktop: primary links + a "Mer" dropdown for low-traffic pages + RSVP as
 * the only filled action. Mobile: RSVP + hamburger that opens a fullscreen
 * menu. Feature-flagged pages drop out of the menus like they did from the
 * old front-page button wall.
 */
import { weddingConfig } from '../config';
import { DEFAULT_FLAGS } from '../services/notion';

interface Props {
  /** Render transparently on top of the hero (home page) */
  overlay?: boolean;
}

interface NavLink {
  href: string;
  label: string;
}

const { overlay = false } = Astro.props;
const flags = Astro.locals.flags ?? DEFAULT_FLAGS;

const primary: NavLink[] = [
  flags.program && { href: '/#schedule', label: 'Program' },
  flags.map && { href: '/kart', label: 'Kart' },
  { href: '/faq', label: 'FAQ' },
  flags.gallery && { href: '/galleri', label: 'Galleri' },
].filter((link): link is NavLink => Boolean(link));

const secondary: NavLink[] = [
  flags.seating && { href: '/bordoppsett', label: 'Bordplassering' },
  { href: '/toastmaster', label: 'Toastmaster' },
  { href: '/forlovere', label: 'Forlovere' },
  flags.music && { href: '/musikk', label: 'Musikkønsker' },
].filter((link): link is NavLink => Boolean(link));

// The fullscreen menu also links the home-page sections
const menuPrimary: NavLink[] = [
  ...primary,
  { href: '/#story', label: 'Vår historie' },
];

const { bride, groom, ampersand } = weddingConfig.names;
---

<header id="site-header" class:list={['inset-x-0 top-0 z-50', overlay ? 'fixed nav-overlay' : 'sticky nav-solid']}>
  <div class="flex items-center justify-between gap-4 px-4 md:px-8 py-3">

    <a href="/" class="nav-wordmark font-wedding text-2xl md:text-3xl leading-none pt-1 select-none" aria-label="Til forsiden">
      <span class="hidden sm:inline">{bride} {ampersand} {groom}</span>
      <span class="sm:hidden">{bride.charAt(0)} &amp; {groom.charAt(0)}</span>
    </a>

    <!-- Desktop -->
    <nav class="hidden md:flex items-center gap-7" aria-label="Hovedmeny">
      {primary.map((link) => <a href={link.href} class="nav-link">{link.label}</a>)}

      <div class="relative">
        <button type="button" id="nav-more" class="nav-link inline-flex items-center gap-1" aria-expanded="false" aria-haspopup="true">
          Mer
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3 h-3" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div id="nav-more-panel" role="menu" aria-label="Flere sider">
          {secondary.map((link) => <a href={link.href} role="menuitem">{link.label}</a>)}
        </div>
      </div>

      {flags.rsvp && <a href="/rsvp" class="nav-rsvp px-5 py-2">RSVP</a>}
    </nav>

    <!-- Mobile -->
    <div class="flex md:hidden items-center gap-1">
      {flags.rsvp && <a href="/rsvp" class="nav-rsvp px-4 py-2">RSVP</a>}
      <button type="button" id="nav-burger" aria-label="Meny" aria-expanded="false" aria-controls="nav-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </div>
</header>

<!-- Fullscreen mobile menu -->
<div id="nav-menu" class="md:hidden" role="dialog" aria-modal="true" aria-label="Meny">
  <nav class="w-full max-w-sm mx-auto">
    <div class="menu-primary flex flex-col">
      {menuPrimary.map((link, index) => (
        <a href={link.href}>
          <span class="menu-num">{String(index + 1).padStart(2, '0')}</span>
          {link.label}
        </a>
      ))}
    </div>

    <div class="w-11 h-px bg-brand-title/20 my-5"></div>

    <div class="menu-secondary flex flex-wrap gap-x-5 gap-y-1">
      {secondary.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    {flags.rsvp && (
      <a href="/rsvp" class="menu-cta block text-center mt-8 px-6 py-4 rounded-lg">
        Svar på invitasjon
      </a>
    )}
  </nav>
</div>

<style is:global>
  #site-header {
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }
  #site-header.nav-overlay {
    color: #fff;
  }
  #site-header.nav-overlay .nav-wordmark {
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    transition: text-shadow 0.3s ease;
  }
  #site-header.nav-overlay .nav-link,
  #site-header.nav-overlay #nav-burger {
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.4));
  }
  #site-header.nav-solid,
  #site-header.nav-overlay.scrolled,
  #site-header.nav-overlay.menu-open {
    color: var(--color-brand-title);
    background: color-mix(in srgb, #fcfbf9 90%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom-color: color-mix(in srgb, var(--color-brand-title) 10%, transparent);
  }
  #site-header.nav-overlay.scrolled .nav-wordmark,
  #site-header.nav-overlay.menu-open .nav-wordmark {
    text-shadow: none;
  }
  #site-header.nav-overlay.scrolled .nav-link,
  #site-header.nav-overlay.scrolled #nav-burger,
  #site-header.nav-overlay.menu-open .nav-link,
  #site-header.nav-overlay.menu-open #nav-burger {
    filter: none;
  }

  #site-header .nav-wordmark {
    color: inherit;
    text-decoration: none;
  }

  .nav-link {
    position: relative;
    padding: 8px 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transition: right 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link[aria-expanded="true"]::after {
    right: 0;
  }

  .nav-rsvp {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    border: 1px solid currentColor;
    color: inherit;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      opacity 0.3s ease;
  }
  #site-header.nav-overlay:not(.scrolled):not(.menu-open) .nav-rsvp:hover {
    background: #fff;
    color: #000;
  }
  #site-header.nav-solid .nav-rsvp,
  #site-header.nav-overlay.scrolled .nav-rsvp,
  #site-header.nav-overlay.menu-open .nav-rsvp {
    background: var(--color-brand-title);
    border-color: var(--color-brand-title);
    color: var(--color-brand-bg);
  }
  #site-header.nav-solid .nav-rsvp:hover,
  #site-header.nav-overlay.scrolled .nav-rsvp:hover {
    opacity: 0.85;
  }

  #nav-more-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: -8px;
    min-width: 200px;
    padding: 6px;
    background: rgba(252, 251, 249, 0.97);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.35);
    color: var(--color-brand-title);
    display: none;
  }
  #nav-more-panel.open {
    display: block;
  }
  #nav-more-panel a {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }
  #nav-more-panel a:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  #nav-burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: none;
    border: 0;
    cursor: pointer;
    color: inherit;
  }
  #nav-burger span {
    display: block;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }
  #site-header.menu-open #nav-burger span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  #site-header.menu-open #nav-burger span:nth-child(2) {
    opacity: 0;
  }
  #site-header.menu-open #nav-burger span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  #nav-menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 96px 40px 48px;
    background: color-mix(in srgb, var(--color-brand-bg) 96%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    color: var(--color-brand-title);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  #nav-menu.open {
    opacity: 1;
    pointer-events: auto;
  }
  #nav-menu .menu-primary a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    transform: translateY(10px);
  }
  #nav-menu.open .menu-primary a {
    animation: nav-rise 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  #nav-menu.open .menu-primary a:nth-child(1) { animation-delay: 0.05s; }
  #nav-menu.open .menu-primary a:nth-child(2) { animation-delay: 0.1s; }
  #nav-menu.open .menu-primary a:nth-child(3) { animation-delay: 0.15s; }
  #nav-menu.open .menu-primary a:nth-child(4) { animation-delay: 0.2s; }
  #nav-menu.open .menu-primary a:nth-child(5) { animation-delay: 0.25s; }
  #nav-menu.open .menu-primary a:nth-child(6) { animation-delay: 0.3s; }
  @keyframes nav-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  #nav-menu .menu-num {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.15em;
    opacity: 0.4;
  }
  #nav-menu .menu-secondary a {
    padding: 8px 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-brand-title) 65%, transparent);
    text-decoration: none;
  }
  #nav-menu .menu-cta {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--color-brand-title);
    color: var(--color-brand-bg);
    text-decoration: none;
  }

  #site-header a:focus-visible,
  #site-header button:focus-visible,
  #nav-menu a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const burger = document.getElementById('nav-burger');
  const menu = document.getElementById('nav-menu');
  const moreBtn = document.getElementById('nav-more');
  const morePanel = document.getElementById('nav-more-panel');

  // Overlay variant: frost the bar once the hero starts scrolling away
  if (header?.classList.contains('nav-overlay')) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const setMenu = (open: boolean) => {
    header?.classList.toggle('menu-open', open);
    menu?.classList.toggle('open', open);
    burger?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('overflow-hidden', open);
  };

  burger?.addEventListener('click', () => {
    setMenu(!menu?.classList.contains('open'));
  });

  // Close the menu when a link is chosen (matters for same-page anchors)
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  const setDropdown = (open: boolean) => {
    morePanel?.classList.toggle('open', open);
    moreBtn?.setAttribute('aria-expanded', String(open));
  };

  moreBtn?.addEventListener('click', (event) => {
    event.stopPropagation();
    setDropdown(!morePanel?.classList.contains('open'));
  });

  document.addEventListener('click', () => setDropdown(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenu(false);
      setDropdown(false);
    }
  });
</script>
